NODE_ENV=production

# Application
APP_PORT=8080
BREVO_API_KEY=replace-me
OTP_DEV=666666

# JWT
AT_SECRET=replace-with-a-long-random-secret
RT_SECRET=replace-with-a-different-long-random-secret

# PostgreSQL
POSTGRES_DB_HOST=db-prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=nest
POSTGRES_DB_PORT=5432
DATABASE_URL=postgresql://postgres:replace-me@db-prod:5432/nest?schema=public

# Runtime ports; only nginx, SSH, and HTTPS are public.
SERVER_PORT=8080
SERVER_PGADMIN_PORT=5050
PGADMIN_PORT=80

# Administration and monitoring
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me

# Public links
APP_STORE_URL=https://apps.apple.com
TELEGRAM_URL=https://t.me/brewly_logs
PRIVACY_POLICY_URL=https://brewly.ru/privacy-policy
